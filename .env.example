# 应用
APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-string
APP_SESSION_COOKIE=smarthr_session
APP_SESSION_EXPIRE_MINUTES=480
APP_SESSION_SECURE=false
OFFER_PORTAL_VERIFICATION_SESSION_MINUTES=15
OFFER_PORTAL_MAX_ATTEMPTS=5
OFFER_PORTAL_LOCK_MINUTES=15
WORKBENCH_OFFER_URGENT_DAYS=2
WORKBENCH_ONBOARDING_URGENT_DAYS=3

# Python 容器构建；网络不稳定时可改为可信镜像
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_DEFAULT_TIMEOUT=120
APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn

# 初始招聘专员账号
INITIAL_RECRUITER_USERNAME=recruiter
INITIAL_RECRUITER_PASSWORD=replace-with-a-strong-password
INITIAL_RECRUITER_DISPLAY_NAME=招聘专员

# PostgreSQL
POSTGRES_DB=smarthr
POSTGRES_USER=smarthr
POSTGRES_PASSWORD=replace-with-a-database-password
DATABASE_URL=postgresql+psycopg://smarthr:replace-with-a-database-password@postgres:5432/smarthr

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# 文件
FILE_STORAGE_ROOT=/app/data/uploads
MAX_RESUME_FILE_SIZE_MB=20
MAX_KNOWLEDGE_FILE_SIZE_MB=10
MAX_BATCH_FILE_COUNT=50
CELERY_WORKER_CONCURRENCY=2

# OpenAI 兼容模型
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=replace-with-an-api-key
AI_MODEL=replace-with-a-model-name
AI_TIMEOUT_SECONDS=120
AI_MAX_CONCURRENCY=3

# OpenAI 兼容 Embedding 服务；未配置前保持关闭
EMBEDDING_ENABLED=false
EMBEDDING_BASE_URL=https://api.example.com/v1
EMBEDDING_API_KEY=replace-with-an-embedding-api-key
EMBEDDING_MODEL=replace-with-an-embedding-model
EMBEDDING_DIMENSION=1536
EMBEDDING_VERSION=v1
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_CONCURRENCY=2

# 知识库文档解析：PDF/DOCX 走 MinerU 精准解析 API（需 API Key，model version 可选 pipeline/vlm）
MINERU_PARSE_BASE_URL=https://mineru.net/api/v4
# 必填：MinerU 精准解析 API 的 Token（MinerU 后台「API 管理」页创建）。未填则 PDF/DOCX 上传会失败。
MINERU_PARSE_API_KEY=
MINERU_PARSE_MODEL_VERSION=pipeline
MINERU_PARSE_TIMEOUT_SECONDS=30
MINERU_PARSE_POLL_INTERVAL_SECONDS=3
MINERU_PARSE_MAX_POLL_SECONDS=120
# 以下为全局默认值(上传时前端只暴露「强制 OCR」+「解析引擎 pipeline/vlm」两项)
KNOWLEDGE_PARSE_FORCE_OCR=false
KNOWLEDGE_PARSE_LANGUAGE=ch
KNOWLEDGE_PARSE_ENABLE_TABLE=true
KNOWLEDGE_PARSE_ENABLE_FORMULA=true
# 只解析指定 PDF 页（如 1-10），默认空=全部页；仅对 PDF 生效
KNOWLEDGE_PARSE_PAGE_RANGE=
